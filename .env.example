# Copy to .env and fill in your values. Never commit .env.

# Required for stock video matching
PEXELS_API_KEY=your_pexels_key_here

# Optional TTS backends
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Required if LLM_BACKEND=claude
ANTHROPIC_API_KEY=

# LLM backend for keyword extraction & clip picking: ollama | claude | openai
LLM_BACKEND=ollama

# WhisperX model size: tiny | base | small | medium | large-v2 | large-v3
WHISPERX_MODEL=large-v2

# Kokoro TTS speed multiplier
KOKORO_SPEED=1.0

# Directory for background music tracks
# MUSIC_DIR=/path/to/music
